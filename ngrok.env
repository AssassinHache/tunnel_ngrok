# Configuracion para Ngrok
# 1. Tu dominio estatico gratuito reservado en https://dashboard.ngrok.com/cloud-edge/domains
# Ejemplo: mi-gimnasio.ngrok-free.app
NGROK_DOMAIN="shirl-inspective-magdalene.ngrok-free.dev"

# 2. Tu authtoken de Ngrok (obtenido en https://dashboard.ngrok.com/get-started/your-authtoken)
# Puedes dejarlo vacio si ya ejecutaste previamente 'ngrok config add-authtoken'
NGROK_AUTHTOKEN=""
